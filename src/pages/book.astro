---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/book.css";
---

<BaseLayout
  title="Book a Consultation — Inoviqa"
  description="Book a 30-minute consultation with Inoviqa to discuss your website, SEO, CRO, tracking, automation, and growth system opportunities."
  path="/book/"
>
  <main class="book-page">
    <section class="book-clean-hero">
      <div class="inq-container">
        <div class="book-clean-grid">
          <div class="book-clean-copy" data-reveal>
            <span class="book-kicker">BOOK A CONSULTATION</span>
            <h1>Book a 30-minute growth consultation.</h1>
            <p>
              Choose a time that works for you. We’ll review your website, goals, conversion gaps, SEO opportunities, tracking needs, and the best next step for growth.
            </p>

            <div class="book-clean-points">
              <span>Website clarity</span>
              <span>SEO direction</span>
              <span>CRO opportunities</span>
              <span>Tracking review</span>
            </div>
          </div>

          <div class="book-cal-card" data-reveal data-reveal-delay="120">
            <div class="book-cal-head">
              <div>
                <span>30 Min Call</span>
                <strong>Walid Hasan / Inoviqa</strong>
              </div>
              <em>Live Calendar</em>
            </div>

            <div class="book-cal-embed">
              <div id="my-cal-inline-30min-call"></div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script is:inline type="text/javascript">
    (function (C, A, L) {
      let p = function (a, ar) {
        a.q.push(ar);
      };

      let d = C.document;

      C.Cal =
        C.Cal ||
        function () {
          let cal = C.Cal;
          let ar = arguments;

          if (!cal.loaded) {
            cal.ns = {};
            cal.q = cal.q || [];
            d.head.appendChild(d.createElement("script")).src = A;
            cal.loaded = true;
          }

          if (ar[0] === L) {
            const api = function () {
              p(api, arguments);
            };

            const namespace = ar[1];
            api.q = api.q || [];

            if (typeof namespace === "string") {
              cal.ns[namespace] = cal.ns[namespace] || api;
              p(cal.ns[namespace], ar);
              p(cal, ["initNamespace", namespace]);
            } else {
              p(cal, ar);
            }

            return;
          }

          p(cal, ar);
        };
    })(window, "https://app.cal.com/embed/embed.js", "init");

    Cal("init", "30min-call", { origin: "https://app.cal.com" });

    Cal.ns["30min-call"]("inline", {
      elementOrSelector: "#my-cal-inline-30min-call",
      config: {
        layout: "month_view",
        useSlotsViewOnSmallScreen: "true",
      },
      calLink: "walidhasan/30min-call",
    });

    Cal.ns["30min-call"]("ui", {
      hideEventTypeDetails: true,
      layout: "month_view",
    });
  </script>
</BaseLayout>