    <script>
      const initHomeTestimonialsCarousel = () => {
        document.querySelectorAll("[data-home-testimonials]").forEach((carousel) => {
          if (carousel.getAttribute("data-carousel-ready") === "true") return;
          carousel.setAttribute("data-carousel-ready", "true");

          const track = carousel.querySelector("[data-home-testimonial-track]");
          const prev = carousel.querySelector("[data-home-testimonial-prev]");
          const next = carousel.querySelector("[data-home-testimonial-next]");
          const counter = carousel.querySelector("[data-home-testimonial-counter]");
          const dotsWrap = carousel.querySelector("[data-home-testimonial-dots]");
          const cards = Array.from(carousel.querySelectorAll(".home-testimonial-card"));

          if (!track || !cards.length) return;

          let current = 0;

          const perView = () => {
            if (window.innerWidth <= 720) return 1;
            if (window.innerWidth <= 1100) return 2;
            return 3;
          };

          const getGap = () => {
            const styles = window.getComputedStyle(track);
            return parseFloat(styles.gap || styles.columnGap || "0") || 0;
          };

          const buildDots = () => {
            if (!dotsWrap) return;

            dotsWrap.innerHTML = "";
            const maxIndex = Math.max(0, cards.length - perView());

            for (let i = 0; i <= maxIndex; i += 1) {
              const dot = document.createElement("button");
              dot.type = "button";
              dot.className = "home-testimonial-dot";
              dot.setAttribute("aria-label", `Go to testimonial ${i + 1}`);
              dot.addEventListener("click", () => {
                current = i;
                update();
              });
              dotsWrap.appendChild(dot);
            }
          };

          const update = () => {
            const maxIndex = Math.max(0, cards.length - perView());
            current = Math.max(0, Math.min(current, maxIndex));

            const cardWidth = cards[0].getBoundingClientRect().width + getGap();
            track.style.transform = `translate3d(${-current * cardWidth}px, 0, 0)`;

            if (counter) {
              counter.textContent = `${String(current + 1).padStart(2, "0")} / ${String(cards.length).padStart(2, "0")}`;
            }

            if (dotsWrap) {
              Array.from(dotsWrap.children).forEach((dot, index) => {
                dot.classList.toggle("is-active", index === current);
              });
            }
          };

          prev?.addEventListener("click", () => {
            const maxIndex = Math.max(0, cards.length - perView());
            current = current <= 0 ? maxIndex : current - 1;
            update();
          });

          next?.addEventListener("click", () => {
            const maxIndex = Math.max(0, cards.length - perView());
            current = current >= maxIndex ? 0 : current + 1;
            update();
          });

          window.addEventListener("resize", () => {
            buildDots();
            update();
          }, { passive: true });

          buildDots();
          update();
        });
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initHomeTestimonialsCarousel);
      } else {
        initHomeTestimonialsCarousel();
      }
    </script>
<!-- 13. FAQ -->
