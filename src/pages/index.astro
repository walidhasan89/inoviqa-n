---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/common/Button.astro";

import {
  auditItems,
  caseStudies,
  faqs,
  growthCards,
  heroProof,
  milestones,
  processSteps,
  products,
  services,
  testimonialBrands,
  whyReasons,
} from "../data/home";

import "../styles/home.css";
import "../styles/home-lower-polish.css";
import "../styles/home-refinements.css";
import "../styles/home-featured-cases.css";
import "../styles/home-why-redesign.css";
import "../styles/home-services-redesign.css";
import "../styles/home-targeted-updates.css";
import "../styles/home-testimonials-carousel.css";

const homeCaseScreenshotFor = (url: string) =>
  `https://s.wordpress.com/mshots/v1/${encodeURIComponent(url)}?w=1200`;

const homeCaseHostFor = (url: string) => {
  try {
    return new URL(url).hostname.replace(/^www\./, "");
  } catch {
    return url;
  }
};

const homeCaseImprovementsFor = (category: string) => {
  if (category.toLowerCase().includes("ecommerce") || category.toLowerCase().includes("fulfillment")) {
    return ["Service clarity", "Trust flow", "Conversion path"];
  }

  if (category.toLowerCase().includes("local")) {
    return ["Local trust", "CTA structure", "Lead capture"];
  }

  if (category.toLowerCase().includes("recruitment")) {
    return ["Audience clarity", "Trust signals", "User journey"];
  }

  return ["Positioning", "Visual clarity", "Inquiry readiness"];
};
const homeTestimonials = [
  {
    quote: "The website finally explains the offer in a way people can understand quickly. The structure feels cleaner, the pages feel more intentional, and the whole experience is easier to trust.",
    name: "Sonia Rahman",
    role: "Personal Brand Consultant",
    project: "Soniya Behrens",
  },
  {
    quote: "We needed the site to feel local, trustworthy, and simple for customers to take action. The improved layout made the service flow much clearer without making the website feel crowded.",
    name: "Mason Walker",
    role: "Exterior Cleaning Owner",
    project: "Silk Waters Windows & Eaves",
  },
  {
    quote: "The biggest difference was clarity. The website stopped feeling like a collection of sections and started feeling like a real journey for the right audience.",
    name: "Priya Coleman",
    role: "Recruitment Platform Lead",
    project: "Jointalently",
  },
  {
    quote: "The new direction helped us communicate fulfillment services in a much more confident way. It became easier for visitors to understand what we do and why they should reach out.",
    name: "Daniel Foster",
    role: "Operations Founder",
    project: "Fulfill My Orders",
  },
  {
    quote: "The ecommerce experience became more focused. Product discovery, trust, and the buying path all felt more polished after the structure was improved.",
    name: "Amina Carter",
    role: "Retail Brand Owner",
    project: "Leds N Baggs",
  },
  {
    quote: "The website now feels more professional and more useful for business conversations. It gives visitors a better first impression and communicates credibility faster.",
    name: "Nabil Hossain",
    role: "Corporate Business Director",
    project: "Pason Global",
