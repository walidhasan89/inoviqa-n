---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/common/Button.astro";
import { serviceDetailPages } from "../../data/service-details";

import "../../styles/service-detail.css";

export function getStaticPaths() {
  return serviceDetailPages.map((service, index) => ({
    params: {
      slug: service.slug,
    },
    props: {
      service,
      index,
    },
  }));
}

const { service } = Astro.props;

const relatedServices = serviceDetailPages
  .filter((item) => item.slug !== service.slug)
  .slice(0, 3);

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: service.title,
  description: service.seoDescription,
  provider: {
    "@type": "Organization",
    name: "Inoviqa LLC",
    url: "https://inoviqa.com",
  },
  areaServed: "Worldwide",
  url: `https://inoviqa.com/services/${service.slug}/`,
};
---

<BaseLayout
  title={service.seoTitle}
  description={service.seoDescription}
  path={`/services/${service.slug}/`}
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <div class="service-detail-page">
    <section class="service-detail-hero">
      <div class="inq-container">
        <div class="service-detail-hero-grid">
          <div data-reveal>
            <span class="service-detail-number">{service.number}</span>
            <span class="inq-kicker">{service.eyebrow}</span>

            <h1 class="service-detail-title">
              {service.title}
            </h1>
          </div>

          <div class="service-detail-copy" data-reveal data-reveal-delay="140">
            <p class="inq-lead">{service.hero}</p>

            <div class="service-detail-tags">
              <span>Attract</span>
              <span>Convert</span>
              <span>Track</span>
              <span>Optimize</span>
              <span>Scale</span>
            </div>

            <div class="inq-hero-actions">
              <Button href="/contact/">Book a Consultation</Button>
              <Button href="/services/" variant="outline">All Services</Button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="service-detail-intro">
      <div class="inq-container">
        <p class="service-detail-statement" data-reveal>
          {service.intro}
        </p>
      </div>
    </section>

    <section class="inq-section-tight">
      <div class="inq-container">
        <div class="service-detail-overview-grid">
          <article class="inq-card service-detail-overview-card" data-reveal data-parallax-card>
            <div class="inq-card-content">
              <span class="inq-kicker">Problem</span>
              <h2>What holds websites back</h2>
              <p>{service.problem}</p>
            </div>
          </article>

          <article
            class="inq-card service-detail-overview-card"
            data-reveal
            data-reveal-delay="120"
            data-parallax-card
          >
            <div class="inq-card-content">
              <span class="inq-kicker">Solution</span>
              <h2>How Inoviqa solves it</h2>
              <p>{service.solution}</p>

              <div class="service-detail-outcome-list">
                {service.outcomes.map((item) => <span>{item}</span>)}
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="inq-section">
      <div class="inq-container">
        <div class="service-detail-section-head">
          <div data-reveal>
            <span class="inq-kicker">Deliverables</span>
            <h2 class="service-detail-section-title">What this service includes</h2>
          </div>

          <p class="service-detail-section-copy" data-reveal data-reveal-delay="120">
            A clear set of strategic, design, technical, tracking, and optimization deliverables
            tailored to the service goal.
          </p>
        </div>

        <div class="service-detail-deliverables-grid">
          {
            service.deliverables.map((item, index) => (
              <article
                class="service-detail-deliverable"
                data-reveal
                data-reveal-delay={String(index * 55)}
              >
                <strong>{String(index + 1).padStart(2, "0")}</strong>
                <span>{item}</span>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="inq-section-tight">
      <div class="inq-container">
        <div class="service-detail-section-head">
          <div data-reveal>
            <span class="inq-kicker">Process</span>
            <h2 class="service-detail-section-title">How we build the system</h2>
          </div>

          <p class="service-detail-section-copy" data-reveal data-reveal-delay="120">
            The process connects diagnosis, strategy, execution, tracking, and optimization so the
            service becomes part of a measurable growth system.
          </p>
        </div>

        <div class="service-detail-process-wrap">
          {
            service.process.map((step, index) => (
              <article
                class="service-detail-process-item"
                data-reveal
                data-reveal-delay={String(index * 70)}
              >
                <span class="service-detail-process-number">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="inq-section-tight">
      <div class="inq-container">
        <div class="service-detail-ideal-card" data-reveal>
          <div>
            <span class="inq-kicker">Best fit</span>
            <h2>Who this service is for</h2>
          </div>

          <div class="service-detail-ideal-list">
            {service.idealFor.map((item) => <span>{item}</span>)}
          </div>
        </div>
      </div>
    </section>

    <section class="inq-section">
      <div class="inq-container">
        <div class="service-detail-section-head">
          <div data-reveal>
            <span class="inq-kicker">Related services</span>
            <h2 class="service-detail-section-title">Build a stronger growth system</h2>
          </div>

          <p class="service-detail-section-copy" data-reveal data-reveal-delay="120">
            Inoviqa services are designed to connect. Combine strategy, SEO, CRO, tracking, lead
            generation, and automation for stronger outcomes.
          </p>
        </div>

        <div class="service-detail-related-grid">
          {
            relatedServices.map((item, index) => (
              <article
                class="inq-card service-detail-related-card"
                data-reveal
                data-reveal-delay={String(index * 90)}
                data-parallax-card
              >
                <div class="inq-card-content">
                  <span class="inq-kicker">{item.number}</span>
                  <h3>{item.title}</h3>
                  <p class="inq-body">{item.hero}</p>
                  <a
                    class="service-detail-related-link"
                    href={`/services/${item.slug}/`}
                    aria-label={`View ${item.title}`}
                  >
                    →
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="inq-section-tight">
      <div class="inq-container">
        <div class="service-detail-cta-card" data-reveal>
          <div>
            <span class="footer-kicker">Start with clarity</span>

            <h2>Ready to turn this service into a growth system?</h2>

            <p>
              Let’s identify the biggest opportunity first — then build a clean, measurable system
              around the pages, traffic, conversions, tracking, and workflows that matter.
            </p>

            <div class="inq-hero-actions service-detail-dark-actions">
              <Button href="/contact/" variant="primary">Book a Consultation</Button>
              <Button href="/services/" variant="outline">View All Services</Button>
            </div>
          </div>

          <div class="service-detail-cta-visual" aria-label="Inoviqa growth system stages">
            <div class="service-detail-cta-row">
              <span>Attract</span>
              <span>Traffic</span>
            </div>
            <div class="service-detail-cta-row">
              <span>Convert</span>
              <span>Leads</span>
            </div>
            <div class="service-detail-cta-row">
              <span>Track</span>
              <span>Data</span>
            </div>
            <div class="service-detail-cta-row">
              <span>Optimize</span>
              <span>CRO</span>
            </div>
            <div class="service-detail-cta-row">
              <span>Scale</span>
              <span>Systems</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="inq-section" id="faq">
      <div class="inq-container">
        <div class="service-detail-section-head">
          <div data-reveal>
            <span class="inq-kicker">FAQ</span>
            <h2 class="service-detail-section-title">Questions about {service.title}?</h2>
          </div>

          <p class="service-detail-section-copy" data-reveal data-reveal-delay="120">
            Quick answers about how this service fits into the Inoviqa growth systems approach.
          </p>
        </div>

        <div class="service-detail-faq-wrap" data-service-detail-faq>
          {
            service.faqs.map((item, index) => (
              <article class:list={["service-detail-faq-item", { "is-open": index === 0 }]}>
                <button
                  class="service-detail-faq-button"
                  type="button"
                  aria-expanded={index === 0 ? "true" : "false"}
                  data-service-detail-faq-button
                >
                  <span>{item.question}</span>
                  <span aria-hidden="true">+</span>
                </button>

                <div class="service-detail-faq-panel" data-service-detail-faq-panel>
                  <p>{item.answer}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>
  </div>

  <script>
    const setupServiceDetailFaq = () => {
      const root = document.querySelector("[data-service-detail-faq]");
      if (!root) return;

      const items = Array.from(root.querySelectorAll(".service-detail-faq-item"));

      const setPanelHeights = () => {
        items.forEach((item) => {
          const panel = item.querySelector("[data-service-detail-faq-panel]");
          if (!panel) return;

          if (item.classList.contains("is-open")) {
            panel.style.maxHeight = `${panel.scrollHeight}px`;
          } else {
            panel.style.maxHeight = "0px";
          }
        });
      };

      items.forEach((item) => {
        const button = item.querySelector("[data-service-detail-faq-button]");

        button?.addEventListener("click", () => {
          const isOpen = item.classList.contains("is-open");

          items.forEach((currentItem) => {
            currentItem.classList.remove("is-open");
            currentItem
              .querySelector("[data-service-detail-faq-button]")
              ?.setAttribute("aria-expanded", "false");
          });

          if (!isOpen) {
            item.classList.add("is-open");
            button.setAttribute("aria-expanded", "true");
          }

          setPanelHeights();
        });
      });

      setPanelHeights();
      window.addEventListener("resize", setPanelHeights, { passive: true });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setupServiceDetailFaq);
    } else {
      setupServiceDetailFaq();
    }
  </script>
</BaseLayout>
